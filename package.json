{
  "name": "memoit",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "node scripts/check-prod-env.mjs && ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "ng lint && node scripts/check-no-functions.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-memoit \"vitest run --config vitest.rules.config.mts\"",
    "emulators": "firebase emulators:start --project demo-memoit",
    "check": "npm run lint && npm run test && npm run test:rules",
    "deploy": "npm run check && npm run build:prod && firebase deploy --only firestore:rules && firebase deploy --only hosting",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-memoit \"playwright test\""
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/material": "22.2.6",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "chart.js": "^4.5.1",
    "firebase": "13.2.0",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  }
}
